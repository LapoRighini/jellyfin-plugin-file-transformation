<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <JellyfinVersion>12.0.0-rc4</JellyfinVersion>
        <JellyfinNugetVersion>$(JellyfinVersion)</JellyfinNugetVersion>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <RepositoryUrl>https://github.com/LapoRighini/jellyfin-plugin-file-transformation</RepositoryUrl>
        <RepositoryType>GitHub</RepositoryType>
        <Description>Jellyfin plugin to allow other plugin developers to intercept and change the delivered web content of jellyfin-web without requiring custom jellyfin-web builds or injected javascript.

This plugin is based on a Pull Request (https://github.com/jellyfin/jellyfin/pull/9095) by https://github.com/JPVenson. Most of the code here was written by him, though adapted to function in a plugin context rather than a native change.</Description>
        
        <Version>3.0.0.1</Version>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
        
      <PackageReference Include="Jellyfin.Model" Version="$(JellyfinNugetVersion)" ExcludeAssets="runtime" />
      <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinNugetVersion)" ExcludeAssets="runtime" />
      <PackageReference Include="Jellyfin.Data" Version="$(JellyfinNugetVersion)" ExcludeAssets="runtime" />
      <PackageReference Include="Jellyfin.Extensions" Version="$(JellyfinNugetVersion)" ExcludeAssets="runtime" />

      <PackageReference Include="Lib.Harmony" Version="2.4.0" GeneratePathProperty="true" />

      <PackageReference Include="prometheus-net" Version="8.2.1" />
      <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
      <PackageReference Include="prometheus-net.DotNetRuntime" Version="4.4.1" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="$(PkgLib_Harmony)\lib\net8.0\0Harmony.dll" />
      <EmbeddedResource Include="Configuration\config.html" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="..\..\README.md" />
        <None Include="..\logo.png" CopyToOutputDirectory="Always" />
    </ItemGroup>

    <!-- The 10.x extension implementations are retained for history but must not
         be compiled for Jellyfin 12, where the startup pipeline is defined inline. -->
    <ItemGroup>
        <Compile Remove="JellyfinVersionSpecific\**\*.cs" />
        <None Include="JellyfinVersionSpecific\**\*.cs" />
    </ItemGroup>
    
</Project>
